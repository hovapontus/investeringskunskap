---
// Third-party iframe (Canva, Google Sheets). Loaded lazily; carries no referrer.
interface Props {
  src: string;
  title?: string;
  height?: number; // fixed pixel height
  ratio?: number; // width / height
}
const { src, height, ratio } = Astro.props;
const host = new URL(src).hostname.replace(/^www\./, '');
const title = Astro.props.title && Astro.props.title !== 'Inbäddat innehåll' ? Astro.props.title : `Inbäddat innehåll från ${host}`;
---

<div class:list={['embed', { fixed: !!height }]} style={height ? `--h:${height}px` : ratio ? `aspect-ratio:${ratio}` : undefined}>
  <iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups" allowfullscreen></iframe>
</div>

<style>
  .embed {
    margin: 1.8rem 0;
    aspect-ratio: 16 / 9;
  }
  .embed.fixed {
    aspect-ratio: auto;
    height: var(--h);
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    box-shadow: 0 2px 8px rgb(63 69 81 / 0.16);
    background: #fff;
  }
</style>
