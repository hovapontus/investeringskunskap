---
// Plain share links: no third-party scripts or tracking pixels.
import { abs } from '../lib/site';

interface Props {
  path: string;
  title: string;
}
const { path, title } = Astro.props;
const url = encodeURIComponent(abs(path));
const text = encodeURIComponent(title);
---

<div class="share" data-share-url={abs(path)} data-share-title={title}>
  <a class="share__btn share__btn--fb" href={`https://www.facebook.com/sharer/sharer.php?u=${url}`} target="_blank" rel="noopener noreferrer">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.5-3.2h-3.2V8.7c0-.9.4-1.7 1.8-1.7h1.5V4.2S15.6 4 14.3 4c-2.6 0-4.3 1.6-4.3 4.4v2.4H7.3V14H10v8z" /></svg>
    <span>Dela på Facebook</span>
  </a>
  <a class="share__btn share__btn--x" href={`https://twitter.com/intent/tweet?url=${url}&text=${text}`} target="_blank" rel="noopener noreferrer">
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.2 2.5h3.3l-7.2 8.3 8.5 11.2h-6.7l-5.2-6.8-6 6.8H1.6l7.7-8.8L1.2 2.5H8l4.7 6.2zm-1.2 17.5h1.8L7 4.4H5.1z" /></svg>
    <span>Dela på X</span>
  </a>
  <button type="button" class="share__btn share__btn--more" hidden aria-label="Dela länken">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M12 3v12M8 7l4-4 4 4" /></svg>
    <span class="share__more-text">Dela</span>
  </button>
</div>

<script>
  // Native share sheet where the browser supports it (hidden otherwise); falls back to copying the link.
  document.querySelectorAll<HTMLElement>('.share').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.share__btn--more');
    if (!btn) return;
    const url = box.dataset.shareUrl!;
    const title = box.dataset.shareTitle!;
    const label = btn.querySelector('.share__more-text')!;
    if (navigator.share) btn.hidden = false;
    else if (navigator.clipboard) {
      btn.hidden = false;
      label.textContent = 'Kopiera länk';
    }
    btn.addEventListener('click', async () => {
      try {
        if (navigator.share) await navigator.share({ title, url });
        else {
          await navigator.clipboard.writeText(url);
          label.textContent = 'Länk kopierad';
          setTimeout(() => (label.textContent = 'Kopiera länk'), 2500);
        }
      } catch {
        /* user cancelled */
      }
    });
  });
</script>

<style>
  .share {
    display: flex;
    gap: 0.5rem;
    margin: 1.6rem 0;
  }
  .share__btn {
    flex: 1 1 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    border: 0;
    cursor: pointer;
  }
  .share__btn[hidden] {
    display: none;
  }
  .share__btn--fb {
    background: #45629f;
  }
  .share__btn--x {
    background: #000;
  }
  .share__btn--more {
    flex: 0 0 auto;
    background: #596068;
  }
  .share__btn:hover {
    filter: brightness(1.12);
  }
  @media (max-width: 520px) {
    .share__btn span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .share__btn--more .share__more-text {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }
  }
</style>
