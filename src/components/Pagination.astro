---
// WordPress-style pagination: /base/, /base/page/2/, /base/page/3/ ...
import { pagePath } from '../lib/content';

interface Props {
  base: string; // e.g. "/category/aktier/"
  current: number;
  total: number;
}
const { base, current, total } = Astro.props;
const href = (p: number) => base + pagePath(p);
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pager" aria-label="Sidnumrering">
      <ul>
        {current > 1 && (
          <li>
            <a href={href(current - 1)} rel="prev" aria-label="Föregående sida">‹</a>
          </li>
        )}
        {pages.map((p) => (
          <li>
            {p === current ? (
              <span class="pager__current" aria-current="page"><span class="sr-only">Sida </span>{p}</span>
            ) : (
              <a href={href(p)}><span class="sr-only">Sida </span>{p}</a>
            )}
          </li>
        ))}
        {current < total && (
          <li>
            <a href={href(current + 1)} rel="next" aria-label="Nästa sida">›</a>
          </li>
        )}
      </ul>
    </nav>
  )
}

<style>
  .pager {
    margin: 2.5rem 0 0;
  }
  ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a,
  .pager__current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink);
    text-decoration: none;
    background: #fff;
  }
  a:hover {
    border-color: var(--chip);
  }
  .pager__current {
    background: var(--chip);
    border-color: var(--chip);
    color: #fff;
  }
</style>
