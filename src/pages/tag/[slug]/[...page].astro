---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { allPosts, tags, tagName, tagUrl, withTag, pagePath, paginate } from '../../../lib/content';
import { SITE } from '../../../lib/site';
import { breadcrumbJsonLd } from '../../../lib/seo';

// /tag/<slug>/ and /tag/<slug>/page/<n>/ . Tags with a single post are thin pages: noindex.
export async function getStaticPaths() {
  const posts = await allPosts();
  return Object.keys(tags).flatMap((slug) => {
    const tagged = withTag(posts, slug);
    if (!tagged.length) return [];
    return paginate(tagged, SITE.pageSize).map((p) => ({
      params: { slug, page: p.page === 1 ? undefined : `page/${p.page}` },
      props: { slug, count: tagged.length, ...p },
    }));
  });
}

const { slug, page, total, items, count } = Astro.props;
const name = tagName(slug);
const base = tagUrl(slug);
const path = base + pagePath(page);
const title = page === 1 ? name : `${name} – sida ${page}`;
---

<BaseLayout
  title={title}
  description={`Alla inlägg taggade ${name} på Investeringskunskap.`}
  path={path}
  noindex={count <= 1}
  prev={page > 1 ? base + pagePath(page - 1) : undefined}
  next={page < total ? base + pagePath(page + 1) : undefined}
  jsonLd={[breadcrumbJsonLd([{ name: 'Hem', path: '/' }, { name, path: base }])]}
>
  <div class="container">
    <header class="page-head">
      <p class="meta">Tagg</p>
      <h1>{name}{page > 1 && <span class="head-page"> – sida {page}</span>}</h1>
    </header>
    <div class="grid">
      {items.map((p) => <PostCard post={p} />)}
    </div>
    <Pagination base={base} current={page} total={total} />
  </div>
</BaseLayout>

<style>
  .page-head .meta {
    margin: 0 0 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .head-page {
    font-weight: 400;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
