---
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, abs } from '../lib/site';

interface Props {
  title: string;
  fullTitle?: string; // exact <title>; default is "<title> | Investeringskunskap"
  description?: string;
  path: string; // canonical path, e.g. "/slug/"
  image?: string; // absolute URL
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  published?: Date;
  modified?: Date;
  author?: string;
  section?: string;
  prev?: string;
  next?: string;
}
const {
  title,
  fullTitle,
  description = SITE.description,
  path,
  image = abs('/og-default.jpg'),
  type = 'website',
  noindex = false,
  jsonLd = [],
  published,
  modified,
  author,
  section,
  prev,
  next,
} = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${SITE.name}`;
const canonical = abs(path);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {prev && <link rel="prev" href={abs(prev)} />}
    {next && <link rel="next" href={abs(next)} />}

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="alternate" type="application/rss+xml" title="Investeringskunskap" href="/feed/" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000f68" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehållet</a>
    <Header currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
